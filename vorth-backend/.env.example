# ==========================================================
# Vorth backend — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual .env file.
# ==========================================================

# ---- schema safety ----------------------------------------------------
# connectDB() applies the schema on boot, and a local .env frequently points at
# a real production database. Two escape hatches, both opt-in:
#
# Let connectDB() apply schema to a managed production host (Neon, RDS, Cloud
# SQL, ...). Refused by default.
# VORTH_ALLOW_SCHEMA_ON_PRODUCTION=1
#
# Connect without touching the schema, for when it is already known good.
# Applying schema is not safe from several processes at once: CREATE INDEX takes
# a lock on its table even when it creates nothing. NOT a deployment mechanism —
# a real instance must be able to bring its own schema up. See the README
# section "Booting several instances at once".
# VORTH_SKIP_SCHEMA=1
# -------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Behind a proxy or load balancer? Render and most hosts terminate TLS and
# forward the real protocol and client in headers. Without this, req.ip is the
# proxy and every rate limiter sees one shared address.
# TRUST_PROXY=false

# PostgreSQL connection string (Neon, Render PostgreSQL, or local PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database
DATABASE_SSL=true

# JSON Web Token
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Used to build links in emails (verification, password reset). Required for
# those flows to work: a reset email with a relative link goes nowhere.
# PUBLIC_URL=https://your-domain.example

# ------------------------------------------------------------------
# Sessions
#
# The access token is short-lived and the refresh token is an httpOnly cookie,
# so a cross-site-scripting bug cannot read the durable credential. Both are
# rotated on every refresh, and reuse of a spent token revokes the family.
# ------------------------------------------------------------------
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=vorth_refresh
# Set to false for clients that cannot hold cookies (native apps): the refresh
# token then comes back in the JSON body instead of a Set-Cookie header.
REFRESH_COOKIE=true
# Must stay true behind HTTPS. Only set false for plain-HTTP local testing.
SECURE_COOKIES=true

# ------------------------------------------------------------------
# Email verification and password reset
#
# Verification is off by default. Turning it on with no working mail transport
# means nobody can ever confirm an address, so preflight reports that
# combination as an error rather than letting it boot quietly.
# ------------------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_HOURS=1

# ------------------------------------------------------------------
# Mail
#
# console  logs the message instead of sending it (development default)
# smtp     sends for real; see src/services/mailer.js
# disabled sends nothing at all - tests only
#
# 'console' in production is reported as an error, which is the point: the
# alternative is shipping a password reset that silently cannot work.
# ------------------------------------------------------------------
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@vorth.example
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# ------------------------------------------------------------------
# File uploads
#
# local writes to uploads/ on the instance's disk. That directory is ephemeral
# on most hosts, so a redeploy deletes every upload - preflight treats 'local'
# in production as an error, not a warning.
#
# s3 targets any S3-compatible service: AWS S3, Cloudflare R2, MinIO,
# Backblaze B2. For a private bucket, uploads go direct via a presigned PUT and
# reads are served through a presigned GET.
# ------------------------------------------------------------------
MAX_UPLOAD_MB=8
STORAGE_DRIVER=local
# S3_BUCKET=vorth-uploads
# S3_REGION=auto
# S3_ENDPOINT=            # leave empty for AWS; set for R2/MinIO/B2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URLS=true
# S3_URL_TTL_SECONDS=3600
# S3_PUBLIC_BASE_URL=     # only for a bucket that serves reads publicly

# ------------------------------------------------------------------
# Rate limiting
#
# memory is per-process, so limits reset on deploy and are not shared across
# instances. Set the store to postgres when running more than one instance.
#
# Uploads get their own limit because they are the one route class that writes
# large user-controlled bytes: up to 60 page images of MAX_UPLOAD_MB each in one
# request. At the general limit that is 144 GB per address per window, and with
# STORAGE_DRIVER=local there is no disk ceiling and no per-user accounting, so one
# account could fill the disk. 10 per window allows a full chapter plus room to
# correct a mistake without waiting out the window.
# ------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20
UPLOAD_RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_STORE=memory

# ------------------------------------------------------------------
# Boot-time configuration report
#
# Findings are logged at boot and nothing fails. Set strict to turn the errors
# into a refusal to start, which is what you want once a deployment is real.
# ------------------------------------------------------------------
# VORTH_STRICT_CONFIG=0
# VORTH_SCHEMA_GUARD_DEBUG=0

# Legal / compliance
MINIMUM_USER_AGE=13
DMCA_CONTACT_EMAIL=dmca@example.com
SUPPORT_CONTACT_EMAIL=support@example.com

# DMCA intake is public and sends email to a third party, so it gets a much
# tighter budget than the general limit.
DMCA_RATE_LIMIT_MAX_REQUESTS=5

# DMCA counter-notice (17 U.S.C. 512(g)). The response window the complainant
# gets, in business days. The statute allows 10 to 14; values outside that range
# are clamped rather than rejected, so 10 below and 14 above are both the default
# and the ceiling. 10 is the default because it is the earliest bound allowed, so
# the clock only ever runs in the complainant's favour.
# DMCA_COUNTER_NOTICE_DAYS=10
#
# Public holidays to exclude, as comma-separated ISO dates. Weekends are always
# excluded. Left empty by default: a wrong holiday calendar silently shifts a
# statutory deadline, and counting only weekdays pushes the deadline later
# rather than earlier, which is the safer direction to be wrong in.
# DMCA_COUNTER_NOTICE_HOLIDAYS=2026-11-26,2026-12-25

# ------------------------------------------------------------------
# Tests only. The suite supplies its own values, so these are just
# enough for `npm run smoke` and ad-hoc requires to load config/env.js.
# ------------------------------------------------------------------
NODE_ENV=test
DATABASE_URL=postgresql://user:password@host/database
DATABASE_SSL=false
JWT_SECRET=test-secret
